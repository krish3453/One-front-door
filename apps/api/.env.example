# ==========================================
# One Front Door — API Environment Variables
# ==========================================

# LLM Configuration
LLM_PROVIDER=google
LLM_MODEL=gemini-3.5-flash-lite
GOOGLE_API_KEY=your_gemini_api_key

# Optional: Groq LLM
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-120b
# GROQ_API_KEY=your_groq_api_key

# Google OAuth2
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Database (Cloud Neon DB PostgreSQL or local Postgres)
DATABASE_URL=postgresql://user:password@ep-your-neon-pooler.aws.neon.tech/one_front_door?sslmode=verify-full&channel_binding=require

# Redis (Cache & Session Store)
REDIS_URL=redis://localhost:6380
CACHE_TTL_SECONDS=3600

# Rate Limiting
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=5

# Qdrant Vector DB
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=one_front_door_knowledge

# Express Session
SESSION_SECRET=change_this_to_a_long_random_string_in_production
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# RAG Ingestion — resume from batch N (default: 1)
START_BATCH=1

